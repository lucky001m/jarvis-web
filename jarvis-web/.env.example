# Copia este archivo a .env.local y pon tus claves reales
# Gemini: consíguela gratis en https://aistudio.google.com/apikey (sin tarjeta de crédito)
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Voz IA de Jarvis (ElevenLabs, opcional): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=tu_clave_de_elevenlabs_aqui
# Opcional: id de una voz concreta de tu librería de ElevenLabs. Si se deja vacío
# se usa una voz masculina grave por defecto.
ELEVENLABS_VOICE_ID=

# Home Assistant (para el control de luces por voz)
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=tu_token_de_home_assistant_aqui
LIGHT_NAME=TV Backlight 3 Lite

# Recordatorios (entidad "Local To-do" en Home Assistant)
TODO_ENTITY_ID=todo.lista_de_la_compra

# Calendario (entidad Google Calendar en Home Assistant)
CALENDAR_ENTITY_ID=calendar.marotomorocholucia001_gmail_com
